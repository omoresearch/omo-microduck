# User service for the sidecar. Install:
#   cp contrib/microduck-sim.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#   systemctl --user enable --now microduck-sim
# Edit WorkingDirectory/ExecStart if you cloned somewhere other than ~/omo-microduck.
[Unit]
Description=Omo Microduck MuJoCo sidecar (127.0.0.1:8796)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/omo-microduck/sidecar
ExecStart=%h/omo-microduck/sidecar/.venv/bin/python %h/omo-microduck/sidecar/server.py
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=PYTHONUNBUFFERED=1
Nice=10
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
