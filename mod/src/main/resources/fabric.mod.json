    ]
  },
  "suggests": {
    "voicechat": ">=2.6.0"
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~26.2"
  },
  "contact": {
    "homepage": "https://www.omo.sh",
    "sources": "https://github.com/omoresearch/omo-microduck",
    "issues": "https://github.com/omoresearch/omo-microduck/issues"
  }
